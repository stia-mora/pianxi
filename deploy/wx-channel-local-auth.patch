@@ -0,0 +1,28 @@
+package handlers
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"wx_channel/internal/config"
+)
+
+func TestInjectedClientReceivesEscapedLocalToken(t *testing.T) {
+	cfg := config.Get()
+	previous := cfg.SecretToken
+	t.Cleanup(func() { cfg.SecretToken = previous })
+	for _, token := range []string{"", "test-secret", `</script><script>alert("x")</script>`} {
+		cfg.SecretToken = token
+		h := &ScriptHandler{apiClientJS: []byte("window.clientStarted=true;")}
+		result := h.buildInjectedScripts("/web/pages/feed")
+		encoded, _ := json.Marshal(token)
+		expected := `<script>window.__WX_LOCAL_TOKEN__=` + string(encoded) + `;</script><script>window.clientStarted=true;</script>`
+		if !strings.Contains(result, expected) {
+			t.Fatal("local token must be safely assigned before the API client starts")
+		}
+		if token != "" && strings.Contains(token, "</script>") && strings.Contains(result, token) {
+			t.Fatal("unescaped token can terminate the script element")
+		}
+	}
+}
