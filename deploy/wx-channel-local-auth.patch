@@ -288,7 +288,14 @@ func (h *ScriptHandler) buildInjectedScripts(path string) string {
 	utilsScript := fmt.Sprintf(`<script>%s</script>`, string(h.utilsJS))
 
 	// API 客户端脚本 - 必须在其他脚本之前加载
-	apiClientScript := fmt.Sprintf(`<script>%s</script>`, string(h.apiClientJS))
+	// Pass the configured credential before the page client opens its socket.
